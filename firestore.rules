rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared rule for all expense log collections.
    // Replace `true` with auth-based rules when you add authentication,
    // e.g.: allow read, write: if request.auth != null;
    match /logs/{docId} {
      allow read, write: if true;
    }

    match /husbandLogs/{docId} {
      allow read, write: if true;
    }

    // Template: copy the block above for each new LogType you add.
  }
}
